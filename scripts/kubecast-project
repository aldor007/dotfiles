#!/bin/sh
# service-repo-project — ensure a dedicated git worktree exists for a project,
# optionally check out a branch in it, then open the project.
#
# Project names, the repo path and service list live in local/projects.env
# (gitignored, rendered via scripts/dotfiles-init.sh) — nothing infra-specific
# is tracked in git. Keep the CLI identical: all that changed is where the
# values come from.
#
# Usage:
#   service-repo-project [--ensure] <project> [branch]
#
#     --ensure   create/checkout only; do not open the project
#     branch     optional branch to check out in the worktree:
#                  - existing local branch  -> checked out
#                  - branch only on origin  -> tracking branch created off it
#                  - anything else         -> new branch off current HEAD
#                  - empty / omitted        -> keep the current branch

set -eu

LOCAL_ENV="${DOTFILES_LOCAL_FILE:-$HOME/dotfiles/local/projects.env}"
if [ ! -f "$LOCAL_ENV" ]; then
  echo "service-repo-project: missing $LOCAL_ENV — run scripts/dotfiles-init.sh" >&2
  exit 1
fi
. "$LOCAL_ENV"

repo="${KUBECAST_REPO:-$HOME/work/service-repo}"

ensure_only=0
if [ "${1:-}" = "--ensure" ]; then
    ensure_only=1
    shift
fi

name="${1:-}"
case " $KUBECAST_PROJECTS " in
    *" $name "*) ;;
    *) echo "usage: service-repo-project [--ensure] <one of: $KUBECAST_PROJECTS> [branch]" >&2; exit 2 ;;
esac

branch="${2:-}"

wt="$repo/.worktrees/$name"

wt_exists=0
if git -C "$repo" worktree list --porcelain | grep -qx "worktree $wt"; then
    wt_exists=1
fi

# Refresh origin refs before basing work on them: new worktree creation
# (branched off origin/master) or an explicit branch checkout (may need
# origin/$branch). Opening an existing worktree without a branch stays
# network-free.
if [ "$wt_exists" -eq 0 ] || [ -n "$branch" ]; then
    if ! git -C "$repo" fetch origin --prune --quiet; then
        echo "service-repo-project: warning: git fetch origin failed, continuing with local refs" >&2
    fi
fi

if [ "$wt_exists" -eq 0 ]; then
    echo "service-repo-project: creating worktree .worktrees/$name (branch '$name' off origin/master)"
    if ! git -C "$repo" worktree add -b "$name" ".worktrees/$name" origin/master; then
        echo "service-repo-project: branch '$name' already exists, checking it out instead"
        git -C "$repo" worktree add ".worktrees/$name" "$name"
    fi
fi

if [ -n "$branch" ] && [ "$(git -C "$wt" branch --show-current)" != "$branch" ]; then
    if git -C "$repo" show-ref --verify --quiet "refs/heads/$branch"; then
        echo "service-repo-project: checking out existing branch '$branch'"
        git -C "$wt" checkout "$branch"
    elif git -C "$repo" show-ref --verify --quiet "refs/remotes/origin/$branch"; then
        echo "service-repo-project: creating branch '$branch' off origin/$branch"
        git -C "$wt" checkout -b "$branch" "origin/$branch"
    else
        echo "service-repo-project: creating new branch '$branch' off current HEAD"
        git -C "$wt" checkout -b "$branch"
    fi
fi

if [ "$ensure_only" -eq 1 ]; then
    exit 0
fi

exec herdr-plus open "$name"