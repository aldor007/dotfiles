# LOCAL config example — copy to <repo>/local/projects.env, fill in values,
# then run scripts/dotfiles-init.sh. This example ships fake values so nothing
# real ever appears in the tracked repo.

DB_USER=you@example.com
DB_NAME=yourapp
SQL_SUFFIX=yourapp

WORK_REPO=/Users/you/work/yourapp
WORK_GROUP=Yourapp
WORK_PROJECTS="one two three"

env_dev_master_project=dev-master-0000
env_dev_master_port=15432
env_prod_master_project=prod-master-0000
env_prod_master_port=15433
env_prod_eu_project=prod-eu-0000
env_prod_eu_port=15434
env_prod_india_project=prod-india-0000
env_prod_india_port=15435