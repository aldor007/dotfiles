#!/bin/sh
# pi -> kimchi adapter for herdr's pi integration AND the herdr-projects
# board (worker/reviewer/coordinator/watcher all run `pi`).
#
# What the board expects from a "pi" program:
#   - started as a plain binary (`herdr agent start --kind pi` runs `pi`)
#   - sessions resume with `pi --session <path>` (kimchi-compatible)
#   - transcripts under $PI_CODING_AGENT_DIR/sessions/*.jsonl ($PI_CODING_AGENT_DIR
#     default ~/.pi/agent) — the board reads them for summaries/tokens.
#
# Kimchi is pi-compatible on the CLI (--session/--resume/--continue) but
# differs elsewhere: it stores sessions where IT decides and does not know
# PI_CODING_AGENT_DIR. This shim bridges both:
#   1. pin the herdr-pi environment (same as the project tabs' launches)
#   2. when no session is given for a real work run, create one inside the
#      board's transcript dir so the board finds it (--no-session / one-shot
#      -p / helpers like setup|login still pass through untouched)

export HERDR_AGENT="${HERDR_AGENT:-pi}"
export KIMCHI_AGENT_SOURCE="${KIMCHI_AGENT_SOURCE:-herdr:pi}"
export KIMCHI_AGENT_NAME="${KIMCHI_AGENT_NAME:-pi}"
export PI_CODING_AGENT_DIR="${PI_CODING_AGENT_DIR:-$HOME/.pi/agent}"

# pass-through invocations that must not grow a --session
wordmatch() {
  for a in "$@"; do
    case "$a" in
      --session|--resume|--continue|--no-session|-p|--print|--export)
        return 0 ;;
      --help|-h|--version|-V|setup|login|update|config|memory|resources)
        return 0 ;;
      mcp|version|claude|opencode|cursor|codex|openclaw|gsd2)
        return 0 ;;
    esac
  done
  return 1
}
if ! wordmatch "$@"; then
  mkdir -p "$PI_CODING_AGENT_DIR/sessions"
  id="$(date +%s%N)"
  # Board work runs get full access (yolo) + a transcript the board can read
  set -- --session "$PI_CODING_AGENT_DIR/sessions/_$id.jsonl" --yolo "$@"
fi

if ! command -v kimchi >/dev/null 2>&1; then
  echo "pi: kimchi not found on PATH" >&2
  exit 127
fi

exec kimchi "$@"